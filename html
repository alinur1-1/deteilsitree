                  <span className="hidden md:inline">Владелец</span>
                </button>
              </div>
            </div>
          </header>

          {/* ОСНОВНОЙ КОНТЕНТ */}
          <main className="relative z-10 max-w-6xl mx-auto px-4 pt-5 space-y-10">

            {/* 1. HERO-БЛОК С ОДНОЙ КРАСИВОЙ ФОТОГРАФИЕЙ И МЯГКИМ ЛЮКСОВЫМ СТЕКЛОМ */}
            <section className="relative rounded-[32px] overflow-hidden border border-white/[0.09] bg-zinc-900/60 shadow-2xl">
