const timeToMinutes = (t) => {
  if (!t) return 0;
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
};

const minutesToTime = (mins) => {
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
};

const formatPrice = (num) => {
  return new Intl.NumberFormat('ru-KZ').format(num || 0) + ' ₸';
};

const formatDuration = (mins) => {
  if (!mins) return '0 мин';
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  if (h > 0 && m > 0) return `${h} ч ${m} мин`;
  if (h > 0) return `${h} ч`;
  return `${m} мин`;
};

const formatPhoneMask = (raw) => {
  const digits = raw.replace(/\D/g, '');
  let clean = digits;
  if (clean.startsWith('8')) clean = '7' + clean.slice(1);
  if (!clean.startsWith('7') && clean.length > 0) clean = '7' + clean;
  clean = clean.slice(0, 11);

  if (clean.length === 0) return '';
  if (clean.length <= 1) return `+7 `;
  if (clean.length <= 4) return `+7 (${clean.slice(1)}`;
  if (clean.length <= 7) return `+7 (${clean.slice(1, 4)}) ${clean.slice(4)}`;
  if (clean.length <= 9) return `+7 (${clean.slice(1, 4)}) ${clean.slice(4, 7)}-${clean.slice(7)}`;
  return `+7 (${clean.slice(1, 4)}) ${clean.slice(4, 7)}-${clean.slice(7, 9)}-${clean.slice(9, 11)}`;
};

const checkBoxAvailability = (boxNumber, dateStr, startMin, durationMin, bookings, business) => {
  const closeMin = timeToMinutes(business.work_end || '21:00');
  const endMin = startMin + durationMin;

  if (endMin > closeMin) {
    return {
      available: false,
      reason: `До закрытия (${business.work_end || '21:00'}) не хватит времени`
    };
  }

  const dayBookings = bookings.filter(
    (b) =>
      b.business_id === business.id &&
      b.date === dateStr &&
      b.box_number === boxNumber &&
      b.status !== 'Отменена'
  );

  for (const b of dayBookings) {
    const bStart = timeToMinutes(b.start_time);
    const bEnd = timeToMinutes(b.end_time);
    if (startMin < bEnd && endMin > bStart) {
      if (startMin >= bStart && startMin < bEnd) {
        return {
          available: false,
          reason: `Занят (${b.start_time}–${b.end_time})`,
          conflictBooking: b
        };
      } else {
        return {
          available: false,
          reason: `Окно до ${b.start_time} слишком короткое`,
          conflictBooking: b
        };
      }
    }
  }

  return { available: true, reason: 'Свободно' };
};

const evaluateSlotAcrossBoxes = (
  dateStr,
  slotTimeStr,
  durationMin,
  selectedBoxPreference,
  bookings,
  business
) => {
  const startMin = timeToMinutes(slotTimeStr);
  const effDuration = Math.max(durationMin || 60, 30);
  const totalBoxes = business.boxes_count || 1;

  if (selectedBoxPreference !== 'auto') {
    const boxNum = Number(selectedBoxPreference);
    const res = checkBoxAvailability(boxNum, dateStr, startMin, effDuration, bookings, business);
    return {
      ...res,
      assignedBox: res.available ? boxNum : null,
      endTimeStr: minutesToTime(startMin + effDuration),
      freeBoxesCount: res.available ? 1 : 0
    };
  }

  const freeBoxes = [];
  let firstReason = 'Занято';

  for (let b = 1; b <= totalBoxes; b++) {
    const check = checkBoxAvailability(b, dateStr, startMin, effDuration, bookings, business);
    if (check.available) {
      freeBoxes.push(b);
    } else if (b === 1 || firstReason.startsWith('Занят')) {
      firstReason = check.reason;
    }
  }

  if (freeBoxes.length > 0) {
    return {
      available: true,
      assignedBox: freeBoxes[0],
      freeBoxes,
      freeBoxesCount: freeBoxes.length,
      endTimeStr: minutesToTime(startMin + effDuration),
      reason: `Свободен Бокс №${freeBoxes[0]}`
    };
  }

  return {
    available: false,
    assignedBox: null,
    freeBoxes: [],
    freeBoxesCount: 0,
    endTimeStr: minutesToTime(startMin + effDuration),
    reason: firstReason
  };
};

const generateTimeSlots = (workStart = '09:00', workEnd = '21:00', stepMinutes = 30) => {
  const start = timeToMinutes(workStart);
  const end = timeToMinutes(workEnd);
  const slots = [];
  for (let m = start; m <= end - stepMinutes; m += stepMinutes) {
    slots.push(minutesToTime(m));
  }
  return slots;
};

const getNext7Days = () => {
  const days = [];
  const dayNames = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
  const monthNames = ['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
  for (let i = 0; i < 7; i++) {
    const d = new Date();
    d.setDate(d.getDate() + i);
    const dateStr = getTodayStr(i);
    days.push({
      dateStr,
      dayName: i === 0 ? 'Сегодня' : i === 1 ? 'Завтра' : dayNames[d.getDay()],
      dayNumber: d.getDate(),
      monthName: monthNames[d.getMonth()],
      isWeekend: d.getDay() === 0 || d.getDay() === 6
    });
  }
  return days;
};

