                    <option value="Детейлинг">Детейлинг</option>
                    <option value="Полировка и Керамика">Полировка и Керамика</option>
                    <option value="Бронепленка PPF">Бронепленка PPF</option>
                    <option value="Химчистка салона">Химчистка салона</option>
                    <option value="SPA-Мойка">SPA-Мойка</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="text-xs text-zinc-400 block mb-1">Описание выполненной работы</label>
                <input
                  type="text"
                  placeholder="Например: Полная оклейка матовым полиуретаном + керамика"
                  value={workPhotoTitleInput}
                  onChange={(e) => setWorkPhotoTitleInput(e.target.value)}
                  className="w-full px-4 py-2.5 rounded-2xl bg-[#09090B] border border-white/[0.1] text-xs text-white"
                />
              </div>

              <button
                type="submit"
                className="w-full py-3.5 rounded-2xl font-semibold text-xs sm:text-sm text-[#09090B] shadow-lg transition hover:brightness-105"
                style={{ backgroundColor: accentColor }}
              >
                Опубликовать в портфолио
              </button>
            </form>
          </div>
        </div>
      )}

      {/* =====================================================================
          MODAL: QUICK CHANGE LOGO & HERO PHOTO BY LINK (WITHOUT TOUCHING CODE)
      ===================================================================== */}
      {showLogoQuickModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="w-full max-w-md rounded-[30px] bg-[#111114] border border-white/[0.12] p-6 space-y-5 shadow-2xl">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <StudioLogo business={activeBusiness} size="md" />
                <div>
                  <h3 className="text-base font-semibold text-white">
                    Логотип и Обложка салона
                  </h3>
                  <p className="text-xs text-zinc-400">?v={activeBusiness.slug}</p>
                </div>
              </div>
              <button
                onClick={() => setShowLogoQuickModal(false)}
                className="p-2 rounded-full bg-white/[0.05] text-zinc-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <div className="space-y-4">
              <div>
                <label className="text-xs text-zinc-400 block mb-1.5">
                  Ссылка на логотип (`logoUrl`)
                </label>
                <input
                  type="url"
                  placeholder="Вставьте прямую ссылку на картинку логотипа..."
                  value={activeBusiness.logoUrl || ''}
                  onChange={(e) => {
                    const val = e.target.value;
                    setBusinesses((prev) =>
                      prev.map((b) =>
                        b.id === activeBusiness.id ? { ...b, logoUrl: val } : b
                      )
                    );
                  }}
                  className="w-full px-3.5 py-2.5 rounded-2xl bg-[#09090B] border border-white/[0.1] text-xs font-mono text-white"
                />
                <span className="text-[11px] text-zinc-500 mt-1 block">
                  Если оставить поле пустым, отображается фирменная монограмма «{activeBusiness.monogram}».
                </span>
              </div>

              <div>
                <label className="text-xs text-zinc-400 block mb-1.5">
                  Ссылка на главную фотографию (`hero_image`)
                </label>
                <input
                  type="url"
                  placeholder="https://..."
                  value={activeBusiness.hero_image || ''}
                  onChange={(e) => {
                    const val = e.target.value;
                    setBusinesses((prev) =>
                      prev.map((b) =>
                        b.id === activeBusiness.id ? { ...b, hero_image: val } : b
                      )
                    );
                  }}
                  className="w-full px-3.5 py-2.5 rounded-2xl bg-[#09090B] border border-white/[0.1] text-xs font-mono text-white"
                />
              </div>

              <button
                onClick={() => {
                  setShowLogoQuickModal(false);
                  showToast('Логотип и обложка сохранены!');
                }}
                className="w-full py-3 rounded-2xl font-semibold text-xs sm:text-sm text-[#09090B]"
                style={{ backgroundColor: accentColor }}
              >
                Готово
              </button>
            </div>
          </div>
        </div>
      )}

      {/* =====================================================================
          MODAL: STUDIO REGISTRY (?v= DIRECTORY & NEW SALON CREATOR)
      ===================================================================== */}
      {showRegistryModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="w-full max-w-2xl rounded-[32px] bg-[#111114] border border-white/[0.12] p-6 space-y-6 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between border-b border-white/[0.08] pb-4">
              <div>
                <span
                  className="text-[10px] font-semibold uppercase tracking-widest block"
                  style={{ color: accentColor }}
                >
                  Мульти-тенантная система
                </span>
                <h3 className="text-lg sm:text-xl font-semibold text-white mt-0.5">
                  Реестр подключенных салонов и детейлингов (`?v=`)
                </h3>
              </div>
              <button
                onClick={() => setShowRegistryModal(false)}
                className="p-2 rounded-full bg-white/[0.05] text-zinc-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Active Studios List */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {businesses.map((biz) => {
                const isCurrent = biz.id === activeBusiness.id;
                return (
                  <div
                    key={biz.id}
                    className={`p-4 rounded-2xl border transition flex items-center justify-between gap-3 ${
                      isCurrent
                        ? 'bg-white/[0.07] border-white/25'
                        : 'bg-[#09090B]/70 border-white/[0.07] hover:border-white/15'
                    }`}
                  >
                    <div
                      onClick={() => {
                        handleSwitchTenant(biz.slug);
                        setShowRegistryModal(false);
                      }}
                      className="flex items-center gap-3 min-w-0 cursor-pointer flex-1"
                    >
                      <StudioLogo business={biz} size="md" />
                      <div className="min-w-0">
                        <h4 className="text-sm font-semibold text-white truncate">
                          {biz.name}
                        </h4>
                        <span className="text-[11px] font-mono text-zinc-400 block">
                          /?v={biz.slug}
                        </span>
                      </div>
                    </div>

                    <button
                      onClick={() => copyDirectStudioUrl(biz.slug)}
                      className="p-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-zinc-300"
                      title="Скопировать ссылку ?v="
                    >
                      <Copy className="w-3.5 h-3.5" />
                    </button>
                  </div>
                );
              })}
            </div>

            {/* Connect New Salon Form */}
            <form
              onSubmit={handleCreateStudioInRegistry}
              className="p-5 rounded-3xl bg-[#09090B] border border-white/[0.08] space-y-4"
            >
              <h4 className="text-sm font-semibold text-white flex items-center gap-2">
                <Plus className="w-4 h-4" style={{ color: accentColor }} />
                <span>Подключить новый салон / детейлинг в реестр</span>
              </h4>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <input
                  type="text"
                  required
                  placeholder="Название (напр. Royal Detailing)"
                  value={newStudioForm.name}
                  onChange={(e) => setNewStudioForm({ ...newStudioForm, name: e.target.value })}
                  className="px-3.5 py-2.5 rounded-2xl bg-zinc-900 border border-white/10 text-xs text-white"
                />
                <input
                  type="text"
                  placeholder="Короткий код для ?v= (напр. royal)"
                  value={newStudioForm.slug}
                  onChange={(e) => setNewStudioForm({ ...newStudioForm, slug: e.target.value })}
                  className="px-3.5 py-2.5 rounded-2xl bg-zinc-900 border border-white/10 text-xs font-mono text-white"
                />
                <input
                  type="text"
                  placeholder="Адрес салона"
                  value={newStudioForm.address}
                  onChange={(e) => setNewStudioForm({ ...newStudioForm, address: e.target.value })}
                  className="px-3.5 py-2.5 rounded-2xl bg-zinc-900 border border-white/10 text-xs text-white"
                />
                <input
                  type="text"
                  placeholder="Телефон (+7 707 ...)"
                  value={newStudioForm.phone}
                  onChange={(e) => setNewStudioForm({ ...newStudioForm, phone: e.target.value })}
                  className="px-3.5 py-2.5 rounded-2xl bg-zinc-900 border border-white/10 text-xs font-mono text-white"
                />
                <input
                  type="url"
                  placeholder="Ссылка на логотип (необязательно)"
                  value={newStudioForm.logoUrl}
                  onChange={(e) => setNewStudioForm({ ...newStudioForm, logoUrl: e.target.value })}
                  className="px-3.5 py-2.5 rounded-2xl bg-zinc-900 border border-white/10 text-xs font-mono text-white sm:col-span-2"
                />
              </div>

              <button
                type="submit"
                className="w-full py-3 rounded-2xl font-semibold text-xs text-[#09090B]"
                style={{ backgroundColor: accentColor }}
              >
                Создать салон и открыть по ?v=
              </button>
            </form>
          </div>
        </div>
      )}

      {/* =====================================================================
          SLIDE-OVER / BOTTOM-SHEET: AI CONCIERGE CHAT
      ===================================================================== */}
      {isAiChatOpen && (
        <div className="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex justify-end">
          <div className="w-full max-w-md bg-[#09090B] border-l border-white/[0.1] h-full flex flex-col justify-between shadow-2xl">
            <div className="p-4 sm:p-5 border-b border-white/[0.08] bg-zinc-900/60 flex items-center justify-between">
              <div className="flex items-center gap-3">
                <StudioLogo business={activeBusiness} size="md" />
                <div>
                  <h3 className="text-sm font-semibold text-white">
                    ИИ-Консьерж • {activeBusiness.shortName || activeBusiness.name}
                  </h3>
                  <p className="text-[11px] text-zinc-400">
                    Подбор свободного бокса и запись в 1 клик
                  </p>
                </div>
              </div>
              <button
                onClick={() => setIsAiChatOpen(false)}
                className="p-2 rounded-full bg-white/[0.05] text-zinc-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Quick Prompt Pills */}
            <div className="px-4 py-2.5 bg-[#09090B] border-b border-white/[0.05] flex items-center gap-2 overflow-x-auto no-scrollbar">
              {[
                'Мойка завтра после 18:00',
                'Полировка + керамика',
                'Свободные окна на сегодня',
                'Химчистка салона'
              ].map((chip) => (
                <button
                  key={chip}
                  onClick={() => handleSendAiMessage(chip)}
                  className="px-3 py-1.5 rounded-full bg-zinc-900 hover:bg-zinc-800 border border-white/[0.08] text-[11px] text-zinc-200 whitespace-nowrap transition shrink-0"
                >
                  {chip}
                </button>
              ))}
            </div>

            {/* Messages */}
            <div className="flex-1 overflow-y-auto p-4 space-y-4">
              {aiMessages.map((m) => (
                <div
                  key={m.id}
                  className={`flex flex-col ${m.role === 'user' ? 'items-end' : 'items-start'}`}
                >
                  <div
                    className={`max-w-[88%] rounded-3xl p-4 text-xs sm:text-sm leading-relaxed space-y-3 ${
                      m.role === 'user'
                        ? 'text-[#09090B] font-medium rounded-br-md'
                        : 'bg-zinc-900/90 border border-white/[0.08] text-zinc-100 rounded-bl-md'
                    }`}
                    style={m.role === 'user' ? { backgroundColor: accentColor } : {}}
                  >
                    <div className="whitespace-pre-line">{m.text}</div>

                    {m.proposal && (
                      <div className="mt-3 p-4 rounded-2xl bg-[#09090B] border border-white/[0.12] space-y-3">
                        <div className="flex items-center justify-between border-b border-white/[0.08] pb-2">
                          <span className="text-[10px] uppercase tracking-wider text-emerald-400 font-semibold">
                            ✓ Свободное окно
                          </span>
                          <span className="text-xs font-mono text-white">
                            Бокс №{m.proposal.boxNumber}
                          </span>
                        </div>

                        <div>
                          <p className="text-xs font-semibold text-white">
                            {m.proposal.service.title}
                          </p>
                          <p className="text-xs font-mono text-zinc-400 mt-0.5">
                            {m.proposal.dayLabel} • {m.proposal.startTime}–{m.proposal.endTime}
                          </p>
                          <p className="text-sm font-bold font-mono text-white mt-1">
                            {formatPrice(m.proposal.price)}
                          </p>
                        </div>

                        {m.booked ? (
                          <div className="p-2.5 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-medium flex items-center justify-between">
                            <span>Запись подтверждена (#{m.bookedTicket?.id})</span>
                            <Check className="w-4 h-4" />
                          </div>
                        ) : (
                          <div className="space-y-2 pt-1">
                            <input
                              type="text"
                              placeholder="Ваше имя"
                              value={aiQuickClientName}
                              onChange={(e) => setAiQuickClientName(e.target.value)}
                              className="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-white/10 text-xs text-white"
                            />
                            <input
                              type="tel"
                              placeholder="Телефон"
                              value={aiQuickClientPhone}
                              onChange={(e) => setAiQuickClientPhone(formatPhoneMask(e.target.value))}
                              className="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-white/10 text-xs font-mono text-white"
                            />
                            <button
                              type="button"
                              onClick={() => handleOneClickAiBooking(m.id, m.proposal)}
                              className="w-full py-2.5 rounded-xl font-semibold text-xs text-[#09090B] transition"
                              style={{ backgroundColor: accentColor }}
                            >
                              Подтвердить в 1 касание
                            </button>
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              ))}

              {aiLoading && (
                <div className="flex items-center gap-2 text-xs text-zinc-400 p-3 rounded-2xl bg-zinc-900/50 w-fit">
                  <RefreshCw className="w-3.5 h-3.5 animate-spin" style={{ color: accentColor }} />
                  <span>Проверяю расписание боксов...</span>
                </div>
              )}
              <div ref={chatEndRef} />
            </div>

            <form
              onSubmit={(e) => {
                e.preventDefault();
                handleSendAiMessage();
              }}
              className="p-3.5 border-t border-white/[0.08] bg-zinc-900/60 flex items-center gap-2"
            >
              <input
                type="text"
                placeholder="Напишите желаемую услугу и время..."
                value={aiInput}
                onChange={(e) => setAiInput(e.target.value)}
                className="flex-1 px-4 py-3 rounded-full bg-[#09090B] border border-white/[0.1] text-xs sm:text-sm text-white placeholder:text-zinc-500 focus:outline-none"
              />
              <button
                type="submit"
                disabled={aiLoading}
                className="p-3 rounded-full text-[#09090B] shrink-0"
                style={{ backgroundColor: accentColor }}
              >
                <Send className="w-4 h-4" />
              </button>
            </form>
          </div>
        </div>
      )}

      {/* =====================================================================
          MODAL: MANUAL BOOKING FOR OWNER
      ===================================================================== */}
      {showManualBookingModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
          <div className="w-full max-w-md rounded-[30px] bg-[#111114] border border-white/[0.12] p-6 space-y-4 shadow-2xl">
            <div className="flex items-center justify-between">
              <h3 className="text-base font-semibold text-white">Ручная запись гостя</h3>
              <button
                onClick={() => setShowManualBookingModal(false)}
                className="p-2 rounded-full bg-white/[0.05] text-zinc-400"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            <form
              onSubmit={(e) => {
                e.preventDefault();
                const srv =
                  activeServices.find((s) => s.id === manualForm.serviceId) || activeServices[0];
                const dur = srv ? srv.duration_minutes : 60;
                const startMin = timeToMinutes(manualForm.startTime);
                const endStr = minutesToTime(startMin + dur);

                const created = {
                  id: `MN-${Math.floor(1000 + Math.random() * 9000)}`,
                  business_id: activeBusiness.id,
                  service_ids: srv ? [srv.id] : [],
                  service_titles: srv ? [srv.title] : ['Запись по телефону'],
                  client_name: manualForm.clientName.trim() || 'Гость по звонку',
                  client_phone: manualForm.clientPhone.trim() || '+7 (701) 000-00-00',
                  car_model: manualForm.carModel.trim() || 'Авто гостя',
                  car_plate: manualForm.carPlate.trim().toUpperCase() || '—',
                  date: manualForm.date,
                  start_time: manualForm.startTime,
                  end_time: endStr,
                  duration_minutes: dur,
                  box_number: Number(manualForm.boxNumber) || 1,
                  total_price: srv ? srv.price : 15000,
                  source: 'manual',
                  status: 'Новая'
                };

                setBookings((prev) => [created, ...prev]);
                setShowManualBookingModal(false);
                showToast(`Бокс №${created.box_number} забронирован на ${created.start_time}`);
              }}
              className="space-y-3"
            >
              <select
                value={manualForm.serviceId}
                onChange={(e) => setManualForm({ ...manualForm, serviceId: e.target.value })}
                className="w-full px-3.5 py-2.5 rounded-2xl bg-[#09090B] border border-white/10 text-xs text-white"
              >
                {activeServices.map((s) => (
                  <option key={s.id} value={s.id}>
                    {s.title} ({formatPrice(s.price)})
                  </option>
                ))}
              </select>

              <div className="grid grid-cols-3 gap-2">
                <input
                  type="date"
                  value={manualForm.date}
                  onChange={(e) => setManualForm({ ...manualForm, date: e.target.value })}
                  className="px-2.5 py-2 rounded-2xl bg-[#09090B] border border-white/10 text-xs font-mono text-white"
                />
                <select
                  value={manualForm.startTime}
                  onChange={(e) => setManualForm({ ...manualForm, startTime: e.target.value })}
                  className="px-2.5 py-2 rounded-2xl bg-[#09090B] border border-white/10 text-xs font-mono text-white"
                >
                  {generateTimeSlots(activeBusiness.work_start, activeBusiness.work_end, 30).map(
                    (t) => (
                      <option key={t} value={t}>{t}</option>
                    )
                  )}
                </select>
                <select
                  value={manualForm.boxNumber}
                  onChange={(e) =>
                    setManualForm({ ...manualForm, boxNumber: Number(e.target.value) })
                  }
                  className="px-2.5 py-2 rounded-2xl bg-[#09090B] border border-white/10 text-xs font-mono text-white"
                >
                  {Array.from({ length: activeBusiness.boxes_count }, (_, i) => i + 1).map((b) => (
                    <option key={b} value={b}>Бокс №{b}</option>
                  ))}
                </select>
              </div>

              <input
                type="text"
                placeholder="Имя гостя"
                value={manualForm.clientName}
                onChange={(e) => setManualForm({ ...manualForm, clientName: e.target.value })}
                className="w-full px-3.5 py-2.5 rounded-2xl bg-[#09090B] border border-white/10 text-xs text-white"
              />
              <input
                type="tel"
                placeholder="Телефон"
                value={manualForm.clientPhone}
                onChange={(e) =>
                  setManualForm({ ...manualForm, clientPhone: formatPhoneMask(e.target.value) })
                }
                className="w-full px-3.5 py-2.5 rounded-2xl bg-[#09090B] border border-white/10 text-xs font-mono text-white"
              />
              <input
                type="text"
                placeholder="Марка авто"
                value={manualForm.carModel}
                onChange={(e) => setManualForm({ ...manualForm, carModel: e.target.value })}
                className="w-full px-3.5 py-2.5 rounded-2xl bg-[#09090B] border border-white/10 text-xs text-white"
              />

              <button
                type="submit"
                className="w-full py-3 rounded-2xl font-semibold text-xs text-[#09090B]"
                style={{ backgroundColor: accentColor }}
              >
                Заблокировать время
              </button>
            </form>
          </div>
        </div>
      )}

      {/* =====================================================================
          LIGHTBOX MODAL FOR REAL DETAILING WORKS
      ===================================================================== */}
      {lightboxImage && (
        <div
          onClick={() => setLightboxImage(null)}
          className="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl flex items-center justify-center p-4"
        >
          <div
            onClick={(e) => e.stopPropagation()}
            className="max-w-3xl w-full rounded-[32px] overflow-hidden bg-[#111114] border border-white/[0.12] shadow-2xl"
          >
            <img
              src={lightboxImage.url}
              alt={lightboxImage.title}
              className="w-full max-h-[72vh] object-cover"
            />
            <div className="p-5 sm:p-6 flex items-center justify-between gap-4">
              <div>
                <div className="flex items-center gap-2">
                  <span
                    className="text-[11px] font-medium px-3 py-0.5 rounded-full"
                    style={{ backgroundColor: `${accentColor}20`, color: accentColor }}
                  >
                    {lightboxImage.tag || 'Детейлинг'}
                  </span>
                  {lightboxImage.car && (
                    <span className="text-xs font-mono text-zinc-400">{lightboxImage.car}</span>
                  )}
                </div>
                <h4 className="text-sm sm:text-base font-semibold text-white mt-1.5">
                  {lightboxImage.title}
                </h4>
              </div>
              <button
                onClick={() => setLightboxImage(null)}
                className="px-4 py-2 rounded-full bg-white/[0.07] hover:bg-white/[0.12] text-xs font-medium text-white shrink-0"
              >
                Закрыть
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
