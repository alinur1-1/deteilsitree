                            setStudios(prev => prev.map(st => st.slug === currentStudio.slug ? { ...st, heroImage: val } : st));
                          }}
                          className="w-full px-3 py-2 rounded-xl bg-zinc-950 border border-white/10 text-xs text-white"
                        />
                      </div>
                    </div>

                    {/* Список активных записей */}
                    <div className="space-y-3">
                      <h4 className="text-sm font-semibold text-zinc-200">Журнал записей и загрузка боксов</h4>
                      {bookings.filter(b => b.studioSlug === currentStudio.slug).map(b => (
                        <div key={b.id} className="p-4 rounded-2xl bg-zinc-900/80 border border-white/[0.08] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                          <div className="space-y-1">
                            <div className="flex items-center gap-2">
                              <span className="text-xs font-semibold text-amber-300">#{b.id} • Бокс №{b.boxNumber}</span>
                              <span className="text-xs text-zinc-400">{b.date} ({b.startTime}–{b.endTime})</span>
                            </div>
                            <p className="text-sm font-medium text-white">{b.clientName} • {b.clientPhone}</p>
                            <p className="text-xs text-zinc-400">{b.carModel} — {b.serviceTitles.join(', ')}</p>
                          </div>
                          <div className="flex items-center gap-2">
                            <span className="text-sm font-semibold text-white mr-2">{formatPrice(b.totalPrice)}</span>
                            <button
                              onClick={() =>
                                setBookings(prev =>
                                  prev.map(x => (x.id === b.id ? { ...x, status: x.status === 'Отменена' ? 'Новая' : 'Отменена' } : x))
                                )
                              }
                              className={`px-3 py-1.5 rounded-xl text-xs border ${
                                b.status === 'Отменена'
                                  ? 'bg-rose-500/10 border-rose-500/30 text-rose-300'
                                  : 'bg-emerald-500/10 border-emerald-500/30 text-emerald-300'
                              }`}
                            >
                              {b.status === 'Отменена' ? 'Отменена (Бокс свободен)' : 'Активна'}
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
