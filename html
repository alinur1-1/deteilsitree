      // ========================================================================
      // ИИ-АССИСТЕНТ (Умный парсер естественного языка + карточки брони в 1 клик)
      // ========================================================================
      const [chatMessages, setChatMessages] = useState([
        {
          role: 'ai',
          text: `Здравствуйте! Я цифровой консьерж студии «${currentStudio.name}». Напишите, какую услугу и на какое время вы хотите записать автомобиль — я проверю свободные боксы и подготовлю талон.`
        }
      ]);
      const [chatInput, setChatInput] = useState('');

      useEffect(() => {
        setChatMessages([
          {
            role: 'ai',
            text: `Здравствуйте! Я цифровой консьерж студии «${currentStudio.name}». Напишите, какую услугу и на какое время вы хотите записать автомобиль — я проверю свободные боксы и подготовлю талон.`
          }
        ]);
      }, [currentStudio.slug]);

      const handleSendChat = (customQuery) => {
        const q = (customQuery || chatInput).trim();
        if (!q) return;
        const userMsg = { role: 'user', text: q };
        setChatInput('');

        const lower = q.toLowerCase();
        const isTomorrow = lower.includes('завтра');
        const targetDate = isTomorrow ? days[1].iso : todayIso;
        const dateLabel = isTomorrow ? 'завтра' : 'сегодня';

        // Поиск подходящей услуги из прайса
        let matchedService = currentStudio.services[0];
        for (const s of currentStudio.services) {
          const titleWords = s.title.toLowerCase().split(' ');
          if (
            (lower.includes('полир') && s.category === 'Полировка') ||
            (lower.includes('химч') && s.category === 'Химчистка') ||
            (lower.includes('пленк') && s.category === 'Бронепленка') ||
            (lower.includes('мойк') && s.category === 'Мойка') ||
            titleWords.some(w => w.length > 4 && lower.includes(w))
          ) {
            matchedService = s;
            break;
          }
        }

        // Желаемое время
        let preferredHour = 14;
        const timeMatch = lower.match(/(\d{1,2})[:\s]?(\d{2})?/);
        if (timeMatch) {
          let h = parseInt(timeMatch[1], 10);
          if (h >= 1 && h <= 7 && (lower.includes('вечер') || lower.includes('после'))) h += 12;
          if (h >= 8 && h <= 20) preferredHour = h;
        } else if (lower.includes('вечер')) {
          preferredHour = 18;
        } else if (lower.includes('утр')) {
          preferredHour = 10;
        }

        // Ищем ближайший свободный слот
        let chosenSlot = null;
        for (let h = preferredHour; h < currentStudio.workHours.end; h++) {
          for (let m of [0, 30]) {
            const candidate = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
