const callGeminiBookingAssistant = async ({
  userMessage,
  business,
  services,
  bookings,
  daysList
}) => {
  const lower = userMessage.toLowerCase();

  let targetDateObj = daysList[0];
  if (lower.includes('завтра') && !lower.includes('послезавтра')) {
    targetDateObj = daysList[1] || daysList[0];
  } else if (lower.includes('послезавтра')) {
    targetDateObj = daysList[2] || daysList[0];
  } else {
    for (const d of daysList) {
      if (lower.includes(d.dayName.toLowerCase())) {
        targetDateObj = d;
        break;
      }
    }
  }

  let minHour = 9;
  const timeMatch = lower.match(/(\d{1,2})[:.](\d{2})/);
  const afterMatch = lower.match(/после\s+(\d{1,2})/);
  const atHourMatch = lower.match(/в\s+(\d{1,2})\s*(час|ч|вечер|утр|дн)?/);

  if (timeMatch) {
    minHour = parseInt(timeMatch[1], 10);
    if (minHour < 8 && (lower.includes('вечер') || lower.includes('после'))) minHour += 12;
  } else if (afterMatch) {
    minHour = parseInt(afterMatch[1], 10);
    if (minHour < 9) minHour += 12;
  } else if (atHourMatch) {
    minHour = parseInt(atHourMatch[1], 10);
    if (minHour < 9) minHour += 12;
  } else if (lower.includes('вечер')) {
    minHour = 18;
  } else if (lower.includes('обед') || lower.includes('днем')) {
    minHour = 13;
  }

  let matchedService = services[0];
  if (lower.includes('полиров') || lower.includes('керамик')) {
    matchedService = services.find((s) => s.category.includes('Полировка') || s.title.toLowerCase().includes('полиров')) || services[0];
  } else if (lower.includes('химчист') || lower.includes('салон') || lower.includes('кож')) {
    matchedService = services.find((s) => s.category === 'Химчистка' || s.title.toLowerCase().includes('химчист')) || services[0];
  } else if (lower.includes('пленк') || lower.includes('брон') || lower.includes('антиграв')) {
    matchedService = services.find((s) => s.title.toLowerCase().includes('брон') || s.title.toLowerCase().includes('пленк')) || services[0];
  } else if (lower.includes('двигат') || lower.includes('мотор')) {
    matchedService = services.find((s) => s.title.toLowerCase().includes('мотор') || s.category === 'Детейлинг') || services[0];
  } else if (lower.includes('кварц') || lower.includes('люкс')) {
    matchedService = services.find((s) => s.title.toLowerCase().includes('люкс') || s.title.toLowerCase().includes('кварц')) || services[0];
  } else if (lower.includes('мойк') || lower.includes('помыт')) {
    matchedService = services.find((s) => s.category === 'Мойка') || services[0];
  }

  const allSlots = generateTimeSlots(business.work_start, business.work_end, 30);
  const candidateSlots = allSlots.filter((s) => timeToMinutes(s) >= minHour * 60);

  let bestSlotEval = null;
  let chosenSlotStr = null;

  for (const s of candidateSlots) {
    const ev = evaluateSlotAcrossBoxes(
      targetDateObj.dateStr,
      s,
      matchedService?.duration_minutes || 60,
      'auto',
      bookings,
      business
    );
    if (ev.available) {
      bestSlotEval = ev;
      chosenSlotStr = s;
      break;
    }
  }

  let fallbackNote = '';
  if (!bestSlotEval) {
    for (const s of allSlots) {
      const ev = evaluateSlotAcrossBoxes(
        targetDateObj.dateStr,
        s,
        matchedService?.duration_minutes || 60,
        'auto',
        bookings,
        business
      );
      if (ev.available) {
        bestSlotEval = ev;
        chosenSlotStr = s;
        fallbackNote = `Так как услуга занимает ${formatDuration(matchedService?.duration_minutes || 60)}, после ${minHour}:00 мы не успеем до закрытия (${business.work_end}). Ближайшее свободное окно:`;
        break;
      }
    }
  }

  const proposal = bestSlotEval && matchedService ? {
    service: matchedService,
    dateStr: targetDateObj.dateStr,
    dayLabel: `${targetDateObj.dayName}, ${targetDateObj.dayNumber} ${targetDateObj.monthName}`,
    startTime: chosenSlotStr,
    endTime: bestSlotEval.endTimeStr,
    boxNumber: bestSlotEval.assignedBox,
    price: matchedService.price,
    durationMinutes: matchedService.duration_minutes
  } : null;

  const apiKey = "";
  const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

  const catalogText = services
    .map((s) => `- ${s.title}: ${formatPrice(s.price)}, длительность ${s.duration_minutes} мин`)
    .join('\n');

  const systemPrompt = `Ты — персональный ИИ-консьерж премиальной детейлинг-студии "${business.name}" (${business.address}, Алматы).
Твой тон: мягкий, деликатный, уважительный (Quiet Luxury).
Прайс-лист:
${catalogText}

Найденное свободное окно:
${proposal ? `Услуга: "${proposal.service.title}", Дата: ${proposal.dayLabel}, Время: ${proposal.startTime}–${proposal.endTime}, Бокс №${proposal.boxNumber}, Стоимость: ${formatPrice(proposal.price)} (${proposal.durationMinutes} мин). ${fallbackNote}` : 'На это время все боксы заняты.'}

Ответь лаконично (2-3 предложения) и предложи подтвердить визит в 1 клик по карточке ниже.`;

  try {
    const response = await fetch(apiUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: userMessage }] }],
        systemInstruction: { parts: [{ text: systemPrompt }] }
      })
    });

    if (response.ok) {
      const data = await response.json();
      const aiText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
      if (aiText) {
        return { text: aiText, proposal };
      }
    }
  } catch (e) {}

  if (lower.includes('сколько стоит') || lower.includes('цен') || lower.includes('прайс')) {
    const priceSummary = services
      .slice(0, 4)
      .map((s) => `• ${s.title} — ${formatPrice(s.price)} (${formatDuration(s.duration_minutes)})`)
      .join('\n');
    return {
      text: `В ателье ${business.name} действуют следующие тарифы:\n${priceSummary}\n\n${
        proposal
          ? `Могу забронировать для вас «${proposal.service.title}» на ${proposal.dayLabel.toLowerCase()} в ${proposal.startTime} (Бокс №${proposal.boxNumber}).`
          : ''
      }`,
      proposal
    };
  }

  if (proposal) {
    return {
      text: `${fallbackNote ? fallbackNote + ' ' : ''}Проверил расписание боксов ${business.name}. Для вас свободно окно на «${proposal.service.title}» — ${proposal.dayLabel.toLowerCase()} в ${proposal.startTime}–{proposal.endTime} (${formatPrice(proposal.price)}, Бокс №${proposal.boxNumber}).\n\nВы можете подтвердить бронь в одно касание ниже:`.replace('{proposal.endTime}', proposal.endTime),
      proposal
    };
  }

  return {
    text: `На выбранное время все боксы заняты. Пожалуйста, выберите другой день или слот в расписании.`,
    proposal: null
  };
};

