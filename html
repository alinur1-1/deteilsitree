        for (let box = 1; box <= currentStudio.boxesCount; box++) {
          const boxBookings = dayBookings.filter(b => b.boxNumber === box);
          const hasOverlap = boxBookings.some(b => {
            const bStart = toMinutes(b.startTime);
            const bEnd = toMinutes(b.endTime);
            return startMin < bEnd && endMin > bStart;
          });
          if (!hasOverlap) {
            return { available: true, freeBox: box };
          }
        }
        return { available: false, freeBox: null, reason: 'Все боксы заняты' };
      };

      const timeSlots = useMemo(() => {
        const slots = [];
        const startH = currentStudio.workHours.start;
        const endH = currentStudio.workHours.end;
        for (let h = startH; h < endH; h++) {
          for (let m of [0, 30]) {
            const tStr = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
            const status = checkSlotAvailability(selectedDate, tStr, totalDuration);
            slots.push({ time: tStr, ...status });
          }
        }
        return slots;
      }, [currentStudio, selectedDate, totalDuration, bookings]);

      // Оформление бронирования
      const handleBookingSubmit = (e) => {
        e.preventDefault();
        if (selectedServices.length === 0 || !selectedTime || !clientName.trim() || clientPhone.length < 6) return;

        const check = checkSlotAvailability(selectedDate, selectedTime, totalDuration);
        if (!check.available) {
          alert('Извините, этот слот только что заняли. Выберите другое время.');
          return;
        }

        const chosenTitles = selectedServices.map(id => {
          const s = currentStudio.services.find(x => x.id === id);
          return s ? s.title : '';
        }).filter(Boolean);

        const endTimeStr = toTimeStr(toMinutes(selectedTime) + totalDuration);
        const newTicket = {
          id: 'LUX-' + Math.floor(1000 + Math.random() * 9000),
          studioSlug: currentStudio.slug,
          clientName: clientName.trim(),
          clientPhone: clientPhone.trim(),
          carModel: carModel.trim() || 'Автомобиль клиента',
          serviceTitles: chosenTitles,
          date: selectedDate,
          startTime: selectedTime,
          endTime: endTimeStr,
          duration: totalDuration,
          totalPrice,
          boxNumber: check.freeBox,
          source: 'web',
          status: 'Новая'
        };

        setBookings(prev => [newTicket, ...prev]);
        setConfirmedTicket(newTicket);
      };

      // Быстрое добавление реального фото работы по ссылке
      const handleAddGalleryPhoto = (e) => {
        e.preventDefault();
        if (!newPhotoUrl.trim()) return;
        const newItem = {
          id: 'ph_' + Date.now(),
          url: newPhotoUrl.trim(),
          car: newPhotoCar.trim() || 'Премиальный автомобиль',
          work: newPhotoDesc.trim() || 'Комплексный детейлинг и защита кузова'
        };
        setStudios(prev => prev.map(st => {
          if (st.slug !== currentStudio.slug) return st;
          return { ...st, gallery: [newItem, ...st.gallery] };
        }));
        setNewPhotoUrl('');
        setNewPhotoCar('');
        setNewPhotoDesc('');
        setShowAddPhotoModal(false);
      };

      // Быстрая смена логотипа по ссылке
      const handleQuickLogoChange = () => {
        const url = prompt('Вставьте прямую ссылку (URL) на новый логотип салона:', currentStudio.logoUrl);
        if (url && url.trim()) {
          setStudios(prev => prev.map(st => st.slug === currentStudio.slug ? { ...st, logoUrl: url.trim() } : st));
        }
      };

      // Копирование ссылки на текущий салон
      const copyShareLink = (slugToCopy = currentStudio.slug) => {
        const url = new URL(window.location.href);
        url.searchParams.set('v', slugToCopy);
